{
  "uid": "konversiku",
  "title": "KonversiKu",
  "tags": [
    "konversiku"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Tugas per status (sekarang)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-konversiku"
      },
      "description": "Jumlah baris tugas di PostgreSQL per status. Berkurang saat retensi menghapus tugas.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-konversiku"
          },
          "refId": "A",
          "expr": "konversiku_tugas{job=\"konversiku\"}",
          "legendFormat": "{{status}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      }
    },
    {
      "id": 2,
      "title": "Total berhasil dan gagal (sepanjang waktu)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-konversiku"
      },
      "description": "Dari tabel job_totals; tidak berkurang oleh retensi 24 jam.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-konversiku"
          },
          "refId": "A",
          "expr": "konversiku_tugas_selesai_total{job=\"konversiku\",hasil=\"success\"}",
          "legendFormat": "berhasil",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-konversiku"
          },
          "refId": "B",
          "expr": "konversiku_tugas_selesai_total{job=\"konversiku\",hasil=\"failed\"}",
          "legendFormat": "gagal",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      }
    },
    {
      "id": 3,
      "title": "Layanan KonversiKu",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-konversiku"
      },
      "description": "1 = /metrics API terjangkau oleh Prometheus.",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-konversiku"
          },
          "refId": "A",
          "expr": "up{job=\"konversiku\"}",
          "legendFormat": "API",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "MATI"
                },
                "1": {
                  "text": "HIDUP"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      }
    },
    {
      "id": 4,
      "title": "CPU terpakai",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-konversiku"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-konversiku"
          },
          "refId": "A",
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[2m])))",
          "legendFormat": "CPU",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "RAM terpakai",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-konversiku"
      },
      "description": "",
      "gridPos": {
        "x": 8,
        "y": 5,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-konversiku"
          },
          "refId": "A",
          "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
          "legendFormat": "RAM",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "Disk / terpakai",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-konversiku"
      },
      "description": "",
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-konversiku"
          },
          "refId": "A",
          "expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"})",
          "legendFormat": "disk /",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "Antrean Redis",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-konversiku"
      },
      "description": "Pesan yang menunggu di Redis. Bisa lebih besar dari tugas queued karena pemulihan mengirim ulang tugas yang menunggu lebih dari 2 menit.",
      "gridPos": {
        "x": 0,
