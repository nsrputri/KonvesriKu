    {
      "id": 9,
      "title": "Tugas selesai per jam",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-konversiku"
      },
      "description": "",
      "gridPos": {
        "x": 16,
        "y": 13,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-konversiku"
          },
          "refId": "A",
          "expr": "increase(konversiku_tugas_selesai_total{job=\"konversiku\"}[1h])",
