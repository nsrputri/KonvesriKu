# Contoh /home/b2-3/konversiku/konversiku.env (tanpa rahasia). Salin, sesuaikan, chmod 600.
# Password Redis TIDAK ditulis di sini; hanya path ke file berisi password (izin 600).
# Redis database 2 untuk produksi: dev memakai 0 dan tes memakai 1. Jangan disamakan, karena
# pekerja dev akan mengambil id tugas produksi dan tugas produksi tertunda sampai pemulihan.
KONVERSIKU_DATA_DIR=/home/b2-3/konversiku-data
KONVERSIKU_DATABASE_URL=postgresql:///konversiku
KONVERSIKU_DB_SCHEMA=public
KONVERSIKU_REDIS_URL=redis://127.0.0.1:6379/2
KONVERSIKU_REDIS_PASSWORD_FILE=/home/b2-3/konversiku/.redis_password
